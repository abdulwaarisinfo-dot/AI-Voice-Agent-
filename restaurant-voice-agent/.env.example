# Names only - copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
# Backend Responses model GPT-Live delegates to (billed separately). Verify your account has access.
OPENAI_DELEGATION_MODEL=gpt-6-luna 
# Text chat (/chat) uses this Responses model directly, no GPT-Live. Empty = reuse OPENAI_DELEGATION_MODEL.
OPENAI_CHAT_MODEL=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=restaurant_voice
DEFAULT_RESTAURANT_ID=demo-restaurant
APP_ENV=development
# Required when APP_ENV=production. Signs owner cookies and order-access links.
SESSION_SECRET=
# The owner login password for /menu. In development the server applies it at startup (restart after changing it).
# Also read by `python -m app.seed`. Pick your own, e.g. 8+ characters.
OWNER_PASSWORD=
# Optional. Enables platform-admin restaurant management (create / list all / archive). Empty = disabled.
ADMIN_PASSWORD=
# Cost guards
MAX_CALL_SECONDS=600
MAX_CONCURRENT_CALLS=5
# Text chat guards
MAX_CHAT_SESSIONS=50
CHAT_IDLE_SECONDS=1800
CHAT_MAX_MESSAGES=60
